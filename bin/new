#!/bin/bash
CONFIG_FILE="$HOME/.new"
USER_TEMPLATES=()

if [[ -f $CONFIG_FILE ]]; then
  while IFS=: read -r name command; do
    USER_TEMPLATES+=("$name:$command")
  done < "$CONFIG_FILE"
fi

# Declare color variables
if [[ $TERM == *color* ]]; then
  COLOR_NEW="\e[1;32m"
  COLOR_TYPE="\e[1;33m"
  COLOR_APP_NAME="\e[1;34m"
  COLOR_ARGUMENTS="\e[1;35m" 
  COLOR_ERROR="\e[1;31m"
  COLOR_RESET="\e[0m"
else
  COLOR_NEW=""
  COLOR_TYPE=""
  COLOR_APP_NAME=""
  COLOR_ARGUMENTS="" 
  COLOR_ERROR=""
  COLOR_RESET=""
fi

# Self-update option (must be after color variables)
if [[ "$1" == "--update" ]]; then
  if [ ! -w "$0" ]; then
    printf "${COLOR_ERROR}Error: You do not have write permissions for $0.${COLOR_RESET}\n"
    printf "${COLOR_TYPE}Try running: sudo $0 --update${COLOR_RESET}\n"
    exit 1
  fi
  printf "${COLOR_NEW}Updating project-new script...${COLOR_RESET}\n"
  if curl -fsSL https://raw.githubusercontent.com/eypacha/project-new/master/bin/new -o "$0"; then
    chmod +x "$0"
    printf "${COLOR_NEW}project-new updated successfully!${COLOR_RESET}\n"
  else
    printf "${COLOR_ERROR}Error: Failed to download the latest version.${COLOR_RESET}\n"
    exit 1
  fi
  exit 0
fi

# Self-update option
if [[ "$1" == "--update" ]]; then
  if [ ! -w "$0" ]; then
    echo "${COLOR_ERROR}Error: You do not have write permissions for $0.${COLOR_RESET}"
    echo "${COLOR_TYPE}Try running: sudo $0 --update${COLOR_RESET}"
    exit 1
  fi
  echo -e "${COLOR_APP_NAME}Updating project-new script...${COLOR_RESET}"
  if curl -fsSL https://raw.githubusercontent.com/eypacha/project-new/master/bin/new -o "$0"; then
    chmod +x "$0"
    echo -e "${COLOR_NEW}project-new updated successfully!${COLOR_RESET}"
  else
    echo "${COLOR_ERROR}Error: Failed to download the latest version.${COLOR_RESET}"
    exit 1
  fi
  exit 0
fi

## List of supported project types
PROJECT_TYPES=(adonis angular ansible astro bun deno django docker electron expo express fastapi fastify flask gatsby gleam go hono hono-deno ionic koa laravel marko nest next nuxt nx payload phoenix pnpm-lib poem qwik rails react redwood remix rust solid spring svelte sveltekit t3 tauri terraform turborepo vite vue zig)

## Function to get the command for a project type
get_project_command() {
  case "$1" in
    adonis)    echo "yarn create adonis-ts-app [app-name]";;
    angular)   echo "ng new [app-name]";;
    ansible)   echo "ansible-galaxy init [app-name]";;
    astro)     echo "yarn create astro [app-name]";;
    bun)       echo "bun create [template] [app-name]";;
    deno)      echo "deno init [app-name]";;
    django)    echo "django-admin startproject [app-name]";;
    docker)    echo "mkdir [app-name] && cd [app-name] && touch Dockerfile docker-compose.yml";;
    electron)  echo "npx create-electron-app [app-name]";;
    expo)      echo "npx create-expo-app [app-name]";;
    expo)      echo "npx create-expo-app [app-name]";;
    express)   echo "yarn create express-app [app-name]";;
    fastapi)   echo "mkdir [app-name] && cd [app-name] && python -m venv venv && source venv/bin/activate && pip install fastapi uvicorn";;
    fastify)   echo "yarn create fastify [app-name]";;
    flask)     echo "mkdir [app-name] && cd [app-name] && python -m venv venv && source venv/bin/activate && pip install Flask";;
    gatsby)    echo "npx gatsby new [app-name]";;
    gleam)     echo "gleam new [app-name]";;
    go)        echo "go mod init [app-name]";;
    hono-deno) echo "deno run -A npm:create-hono@latest [app-name]";;
    hono)      echo "yarn create hono [app-name]";;
    ionic)     echo "ionic start [app-name] blank --type=react";;
    koa)       echo "npx koa-generator [app-name]";;
    laravel)   echo "composer create-project --prefer-dist laravel/laravel [app-name]";;
    marko)     echo "npx create-marko [app-name]";;
    nest)      echo "yarn global add @nestjs/cli && nest new [app-name]";;
    next)      echo "npx create-next-app [app-name]";;
    nuxt)      echo "npx nuxi init";;
    nx)        echo "npx create-nx-workspace [app-name]";;
    payload)   echo "npx create-payload-app -n [app-name] [arguments...]";;
    phoenix)   echo "mix phx.new [app-name]";;
    pnpm-lib)  echo "pnpm init";;
    poem)      echo "mkdir [app-name] && cd [app-name] cargo add poem";;
    qwik)      echo "yarn create qwik [app-name]";;
    rails)     echo "rails new [app-name]";;
    react)     echo "npx create-react-app [app-name]";;
    redwood)   echo "yarn create redwood-app [app-name]";;
    remix)     echo "yarn create remix [app-name]";;
    rust)      echo "cargo new [app-name] [arguments...]";;
    solid)     echo "yarn create solid [app-name]";;
    spring)    echo "curl https://start.spring.io/starter.zip -d dependencies=web -d name=[app-name]";;
    svelte)    echo "npx degit sveltejs/template [app-name]";;
    sveltekit) echo "yarn create svelte [app-name]";;
    t3)        echo "yarn create t3-app [app-name]";;
    tauri)     echo "npm create tauri-app@latest [app-name]";;
    terraform) echo "mkdir [app-name] && cd [app-name] && terraform init";;
    turborepo) echo "npx create-turbo [app-name]";;
    vite)      echo "yarn create vite [app-name]";;
    vue)       echo "vue create [app-name]";;
    zig)       echo "zig init-exe";;
    
    *)         echo "";;
  esac
}

# Declare a variable for usage message
USAGE_MESSAGE="${COLOR_NEW}new${COLOR_RESET} ${COLOR_TYPE}[type]${COLOR_RESET} ${COLOR_APP_NAME}[app-name]${COLOR_RESET} ${COLOR_ARGUMENTS}[arguments...]${COLOR_RESET} \n"

# Declare show_help function
show_help() {
  printf "Usage: $USAGE_MESSAGE \n"
  printf "Options:\n" 
  printf "  --help, -h         Show this help message \n"
  printf "  --templates, -t    Show all templates \n"
  printf "  --add-template     Add or override a custom template \n"
  printf "  --remove-template  Remove a custom template \n"
  printf "  --update           Update/reinstall project-new script \n"
  exit 0
}

# Check for help flag
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  show_help
fi

## Function to show available templates
show_templates() {
  printf "Available templates:\n"
  for type in "${PROJECT_TYPES[@]}"; do
    cmd=$(get_project_command "$type")
    command_colored="${cmd}"
    command_colored="${command_colored//\[app-name\]/${COLOR_APP_NAME}[app-name]${COLOR_RESET}}"
    command_colored="${command_colored//\[arguments...\]/${COLOR_ARGUMENTS}[arguments...]${COLOR_RESET}}"
    printf "%b%b%b%b%b\n" "${COLOR_TYPE}$type${COLOR_RESET}" "${COLOR_ARGUMENTS} = ${COLOR_RESET}" "${COLOR_COMMAND}" "$command_colored" "${COLOR_RESET}"
  done

  if [[ -f "$CONFIG_FILE" ]]; then

    if [[ -s "$CONFIG_FILE" ]]; then
        printf "\nUser-defined templates:\n"
        while IFS=: read -r user_template_name user_command; do
            user_command_colored="${user_command//\[app-name\]/${COLOR_APP_NAME}[app-name]${COLOR_RESET}}"
            printf "%b%b%b%b%b\n" "${COLOR_TYPE}$user_template_name${COLOR_RESET}" "${COLOR_ARGUMENTS}=${COLOR_RESET}" "${COLOR_COMMAND}" "$user_command_colored" "${COLOR_RESET}"
        done < "$CONFIG_FILE"
    fi
  fi
  exit 0
}

## Check for help flag
if [[ "$1" == "-t" || "$1" == "--templates" ]]; then
  show_templates
fi

add_template() {
  printf "${COLOR_TYPE}Enter template name: ${COLOR_RESET}"
  read -r template_name
  printf "${COLOR_TYPE}Enter command: ${COLOR_RESET}"
  read -r command

  if [[ -n "$template_name" && -n "$command" ]]; then
    # Replace the template if it already exists, otherwise append it
    sed -i.bak "/^$template_name:/d" "$CONFIG_FILE"  # Remove existing template
    printf "$template_name:$command\n" >> "$CONFIG_FILE"  # Add new/updated template
    printf "${COLOR_TYPE}${template_name}${COLOR_RESET} ${COLOR_NEW}template added or updated.${COLOR_RESET} \n"
    exit 0
  else
    printf "${COLOR_ERROR}Error: Template name or command cannot be empty.${COLOR_RESET} \n"
    exit 1
  fi
}

## Check for add-template flag
if [[ "$1" == "--add-template" ]]; then
  add_template
  exit 0
fi

remove_template() {
  printf "${COLOR_TYPE}Enter template name to remove: ${COLOR_RESET}"
  read -r template_name

  if [[ -z "$template_name" ]]; then
    printf "${COLOR_ERROR}Error: Template name cannot be empty.${COLOR_RESET}\n"
    exit 1
  fi

  # Check if the configuration file exists
  if [[ -f "$CONFIG_FILE" ]]; then
    # Use sed to delete the line corresponding to the template
    sed -i.bak "/^$template_name:/d" "$CONFIG_FILE"
    
    # Check if any deletion was made
    if [[ $? -eq 0 ]]; then
      printf "${COLOR_TYPE}${template_name}${COLOR_RESET} ${COLOR_NEW}template removed.${COLOR_RESET}\n"
    else
      printf "${COLOR_ERROR}Error: Template '${template_name}' not found.${COLOR_RESET}\n"
    fi
  else
    printf "${COLOR_ERROR}Error: Configuration file does not exist.${COLOR_RESET}\n"
  fi
  exit 0
}

## Check if the remove-template option was passed
if [[ "$1" == "--remove-template" ]]; then
  remove_template
  exit 0
fi

## Check if enough arguments have been provided
if [ "$#" -lt 1 ]; then
  printf "Usage: $USAGE_MESSAGE\n"  # Print only the usage message
  exit 1
fi

## Variables
TYPE=$1
APP_NAME=${2:-""}
ARGUMENTS="${@:3}"  # Capture all arguments from the third one onward

## Function to check if a command exists
check_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf "${COLOR_TYPE}Warning: The command '%s' is not found. Would you like to install it?${COLOR_RESET} (y/n)\n" "$1"
    read -r answer
    if [[ "$answer" == "y" ]]; then
      case "$1" in
        ng)
          printf "Installing Angular CLI...\n"
          npm install -g @angular/cli
          ;;
        cargo)
          printf "Installing Rust and Cargo...\n"
          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
          printf "Please add \$HOME/.cargo/bin to your PATH.\n"
          ;;
        composer)
          printf "Installing Composer...\n"
          curl -sS https://getcomposer.org/installer | php
          mv composer.phar /usr/local/bin/composer
          ;;
        # Add other commands as needed
        *)
          printf "${COLOR_ERROR}No installation script available for '%s'. Please install it manually.${COLOR_RESET}\n" "$1"
          ;;
      esac
    else
      printf "${COLOR_ERROR}Aborting project creation.${COLOR_RESET}\n"
      exit 1
    fi
  }
}

## Check if the project type is supported by user-defined templates first
if [[ -f "$CONFIG_FILE" ]]; then
    while IFS=: read -r user_template_name user_command; do
        if [[ "$TYPE" == "$user_template_name" ]]; then
            # Replace [app-name] and [arguments] in the user-defined command
            command="${user_command}"
            command="${command//\[app-name\]/$APP_NAME}"
            command="${command//\[arguments...\]/$ARGUMENTS}"
            # Attempt to run the command
            if ! eval $command; then
                # Extract the command name for error handling
                cmd_name=$(echo "$command" | awk '{print $1}')
                check_command "$cmd_name"  # Check if the command exists
            fi
            exit 0
        fi
    done < "$CONFIG_FILE"
fi




## Execute the command for the project type if it exists
command=$(get_project_command "$TYPE")
if [[ -n "$command" ]]; then
    command="${command//\[app-name\]/$APP_NAME}"
    command="${command//\[arguments...\]/$ARGUMENTS}"
    # Attempt to run the command
    if ! eval $command; then
      # Extract the command name for error handling
      cmd_name=$(echo "$command" | awk '{print $1}')
      check_command "$cmd_name"  # Check if the command exists
    fi
    exit 0
fi

printf "${COLOR_ERROR}Unsupported project type:${COLOR_RESET} ${COLOR_TYPE}$TYPE${COLOR_RESET}\n"
exit 1
